<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ik_api_auth_token__formview" model="ir.ui.view">
            <field name="name">ik.api_auth_token.formview</field>
            <field name="model">ik.api_auth_token</field>
            <field name="priority" eval="15"/>
            <field name="arch" type="xml">
                <form>
                    <header>
                            <button class="btn-warning"
                                    type="object"
                                    string="Regenerate Credentials"
                                    icon="fa-refresh"
                                    name="btn_regenerate_credentials"
                                    confirm="Are you sure you want to regenerate the credentials? The old ones will stop working immediately." />
                            <button class="btn-danger"
                                    type="object"
                                    string="Restore Token"
                                    attrs="{'invisible': [('is_compromised','=',False)]}"
                                    icon="fa-cog"
                                    groups="base.group_no_one"
                                    name="btn_restore_token" />

                        <!--field name="state" widget="statusbar" statusbar_visible="draft,sent,sale"/-->
                    </header>                    
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button"
                                    type="object"
                                    string="Refresh"
                                    icon="fa-refresh"
                                    name="btn_refresh" />

                        </div>
                        
                        <div>
                            <h1>
                                <field name="name"  />
                            </h1>
                            <div class="o_row">
                                <field name="description" default_focus="1" placeholder="Enter description here" />
                            </div>

                        </div>
    
                        <group>
                            <group>
                                <field name="token_type" />
                                <field name="user_id" />
                                <field name="enforce_integrity" />
                            </group>
                            <group>
                                <field name="expiration_ts" />
                                <field name="is_compromised" />
                            </group>
                            <group colspan="4" attrs="{'invisible': [('token_type','not in',['bearer','xgitlabtoken'])]}">
                                <field name="test_use_header" widget="boolean_toggle"/>
                                <field name="static_token" widget="CopyClipboardChar" attrs="{'required': [('token_type','in',['bearer','xgitlabtoken'])]}"/>
                                <field name="hello_curl" widget="CopyClipboardChar" style="text-align: left;"/>
                            </group>
                            <group string="AWS Credentials" colspan="4" attrs="{'invisible': [('token_type','!=','awssigv4')]}">
                                <field name="awssigv4_access_key_id" string="ACCESS KEY ID" widget="CopyClipboardChar" placeholder="AKIA..." />
                                <field name="awssigv4_secret_access_key" string="SECRET ACCESS KEY" widget="CopyClipboardChar" placeholder="40-character secret key" />
                                <field name="hello_curl" widget="CopyClipboardChar" style="text-align: left;" string="AWS SigV4 Test cURL"/>
                            </group>
                            <group string="HTTP Basic Credentials" colspan="4" col="2" attrs="{'invisible': [('token_type','!=','httpbasicauth')]}">
                                <field name="httpbasicauth_username" string="Username" widget="CopyClipboardChar" readonly="1" />
                                <field name="httpbasicauth_password_hash" string="Password Hash (Technical)" readonly="1"  />
                                <field name="hello_curl" widget="CopyClipboardChar" style="text-align: left;" string="HTTP Basic Test cURL"/>
                                <div class="alert alert-info" role="alert" colspan="2">
                                    <strong>Note:</strong> Use the "Regenerate Credentials" button to generate or update your HTTP Basic authentication credentials.
                                    The wizard will allow you to set custom credentials or auto-generate secure ones.
                                </div>
                            </group>

                        </group>
                        <notebook>
                            <page string="Security log">
                                <field name="security_log" colspan="4" />
                            </page>
                            <page string="Documentation" attrs="{'invisible': ['&amp;', ('static_token','=',False), ('awssigv4_access_key_id','=',False), ('httpbasicauth_username','=',False)]}">
                                <field name="python_examples" nolabel="1" readonly="1"/>
                            </page>
                            <page string="Advanced">
                                <group>
                                    <group>
                                        <field name="id"  />
                                    </group>
                                    <group>
                                        <field name="create_date"  />
                                        <field name="write_date"  />
                                    </group>
                                </group>

                            </page>

                        </notebook>
    
                    </sheet>
                </form>
            </field>
        </record>


        <record id="ik_api_auth_token__treeview" model="ir.ui.view">
            <field name="name">ik.api_auth_token.treeview</field>
            <field name="model">ik.api_auth_token</field>
            <field name="priority" eval="15"/>
            <field name="arch" type="xml">
                <tree>
                    <field name="user_id"/>
                    <field name="token_type"/>
                    <field name="expiration_ts"/>
                    <field name="description"  optional="show" />
                    <field name="is_compromised" string="Compromised" />
                </tree>
            </field>
        </record>
        
        <record id="ik_api_auth_token__actwindow" model="ir.actions.act_window">
            <field name="name">API Auth Tokens</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ik.api_auth_token</field>
            <field name="view_mode">tree,form</field>
            <field name="context"></field>
        </record>
    </data>
</odoo>