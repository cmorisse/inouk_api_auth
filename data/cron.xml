<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OAuth token cleanup delay (hours) - keep expired tokens for auditing -->
    <record id="oauth_token_cleanup_delay_hours" model="ir.config_parameter">
        <field name="key">inouk_api_auth.oauth_token_cleanup_delay_hours</field>
        <field name="value">168</field>
    </record>

    <record id="ir_cron_cleanup_oauth_tokens" model="ir.cron">
        <field name="name">Cleanup expired OAuth access tokens</field>
        <field name="model_id" ref="model_ik_api_auth_token"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_expired_oauth_tokens()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
