<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="httpbasic_credentials_wizard_form" model="ir.ui.view">
            <field name="name">ik.httpbasic_credentials_wizard.form</field>
            <field name="model">ik.httpbasic_credentials_wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="state" invisible="1"/>
                        <field name="token_id" invisible="1"/>

                        <!-- Input State -->
                        <group attrs="{'invisible': [('state', '!=', 'input')]}" colspan="2" col="2">
                            <h2 colspan="2">Generate HTTP Basic Authentication Credentials</h2>
                            <div colspan="2" class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle"/> Configure your HTTP Basic authentication credentials below.
                                Leave fields empty to auto-generate secure values.
                            </div>
                            <group colspan="2">
                                <field name="username"
                                       placeholder="e.g., api_user_prod"
                                       help="Username for HTTP Basic authentication. Leave empty to auto-generate."/>
                                <field name="password"
                                       placeholder="Leave empty for secure auto-generation"
                                       password="True"
                                       help="Password for HTTP Basic authentication. Must be at least 8 characters."/>
                            </group>
                        </group>

                        <!-- Display State -->
                        <group attrs="{'invisible': [('state', '!=', 'display')]}"  col="2">
                            <h2 colspan="2">HTTP Basic Credentials Generated</h2>
                            <div colspan="2" class="alert alert-warning" role="alert">
                                <strong><i class="fa fa-exclamation-triangle"/> Important:</strong>
                                Save these credentials immediately! They cannot be retrieved after closing this window.
                                The password is stored securely (hashed) and cannot be recovered.
                            </div>

                            <group colspan="2">
                                <field name="generated_username"
                                       widget="CopyClipboardChar"
                                       string="Username"/>
                                <field name="generated_password"
                                       widget="CopyClipboardChar"
                                       string="Password"/>
                                <field name="auth_header"
                                       widget="CopyClipboardChar"
                                       string="Authorization Header Value"/>
                                <label for="curl_command" string="Test cURL Command"/>
                                <field name="curl_command"
                                       widget="CopyClipboardText"
                                       nolabel="1"/>
                            </group>


                            <div colspan="2" class="alert alert-success" role="alert">
                                <i class="fa fa-check-circle"/> The credentials have been saved to your API token.
                                You can now use them for HTTP Basic authentication.
                            </div>
                        </group>
                    </sheet>

                    <footer>
                        <button name="generate_credentials"
                                type="object"
                                string="Generate Credentials"
                                class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'input')]}"/>
                        <button name="confirm_and_close"
                                type="object"
                                string="Done"
                                class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'display')]}"/>
                        <button string="Cancel" special="cancel" class="btn-default"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action to open the wizard -->
        <record id="action_httpbasic_credentials_wizard" model="ir.actions.act_window">
            <field name="name">Generate HTTP Basic Credentials</field>
            <field name="res_model">ik.httpbasic_credentials_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>