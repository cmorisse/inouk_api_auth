<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         The mpy-cli and mgx-cli OAuth clients used to live here. As of P2.c.2
         they moved to the addon that owns the corresponding MCP provider:

           - mpy-cli   → inouk_mcp_muppy/data/oauth_clients__mpy.xml
           - mgx-cli   → muppy_manganese/data/oauth_clients__mgx.xml

         Each new file uses delete_externalid + upsert_externalid to transfer
         ownership of the existing ik.oauth_client_registration row from
         inouk_api_auth to the new module without dropping the underlying record
         (so previously issued tokens keep working).

         inouk_api_auth stays generic — it ships the OAuth machinery, not the
         CLI clients.
         ═══════════════════════════════════════════════════════════════════════════ -->

</odoo>
